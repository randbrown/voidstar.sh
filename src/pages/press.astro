---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { press, PRESS_ZIP } from '../data/press';
import { videos as rawVideos, enrichWithOEmbed } from '../data/videos';

const videos = await enrichWithOEmbed(rawVideos);
const featured = videos.find(v => v.featured) ?? videos[0];
const moreVideos = videos.filter(v => v !== featured).slice(0, 2);

// press.files lists repo-relative paths; resolve the src/assets/ ones to
// astro:assets images (optimized thumbnails + a hashed full-size URL to view or
// download). public/ files are served as-is.
const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/**/*.{jpg,png}', { eager: true },
);
const toImage = (p: string) => {
  const mod = assetImages[p.replace(/^src\//, '../')];
  if (!mod) throw new Error(`press.files: no asset at ${p}`);
  return mod.default;
};
const photos = press.files.photos.map(f => ({ ...f, img: toImage(f.path) }));
const logos = press.files.logos.map(f => ({ ...f, img: toImage(f.path) }));
const art = press.files.art.map(f => ({ ...f, src: f.path.replace(/^public/, '') }));
const [heroPhoto] = photos;

const { bios, contact } = press;
---
<BaseLayout
  title="Press kit"
  description={`voidstar (Randy Brown's voidstar) press kit — bios, billing, video, tech rider, photos, logos, and booking contact.`}
>
  <div class="press-wrap">
    <div class="container">

      <!-- Header -->
      <header class="press-header">
        <div class="press-header-copy">
          <div class="press-label">// press kit</div>
          <h1 class="press-title">voidstar</h1>
          <p class="press-aka">also billed as <strong>{press.altBilling}</strong></p>
          <p class="press-oneliner">{press.oneLiner}</p>
          <nav class="press-toc" aria-label="Press kit sections">
            <a href="#bio">bio</a>
            <a href="#billing">billing</a>
            <a href="#watch">watch</a>
            <a href="#show">the show</a>
            <a href="#rider">rider</a>
            <a href="#assets">photos & logos</a>
            <a href="#randy">randy brown</a>
            <a href="#contact">booking</a>
          </nav>
        </div>
        <figure class="press-hero">
          <Image
            src={heroPhoto.img}
            alt={heroPhoto.alt}
            widths={[360, 540, 720]}
            sizes="(max-width: 820px) 100vw, 360px"
            class="press-hero-img"
            loading="eager"
          />
          {heroPhoto.credit && <figcaption>photo: {heroPhoto.credit}</figcaption>}
        </figure>
      </header>

      <!-- Fact sheet + short bio -->
      <section class="press-section fact-grid" id="bio">
        <dl class="facts">
          {press.facts.map(({ k, v }) => (
            <div class="fact"><dt>{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>

        <div class="bios">
          <article class="bio" data-bio>
            <div class="bio-head">
              <h2 class="bio-label">short bio <span class="bio-count">· one line</span></h2>
              <button type="button" class="copy-btn" data-copy>copy</button>
            </div>
            <p data-copy-src>{bios.short}</p>
          </article>

          <article class="bio" data-bio>
            <div class="bio-head">
              <h2 class="bio-label">medium bio <span class="bio-count">· one paragraph</span></h2>
              <button type="button" class="copy-btn" data-copy>copy</button>
            </div>
            <p data-copy-src>{bios.medium}</p>
          </article>

          <details class="bio bio-long" data-bio>
            <summary class="bio-head">
              <h2 class="bio-label">long bio <span class="bio-count">· full story</span></h2>
              <button type="button" class="copy-btn" data-copy>copy</button>
            </summary>
            <div data-copy-src>
              {bios.long.map(p => <p>{p}</p>)}
            </div>
          </details>
        </div>
      </section>

      <!-- Billing -->
      <section class="press-section" id="billing">
        <h2 class="section-heading"><span class="heading-accent">$</span> how to bill it</h2>
        <div class="billing-grid">
          {press.billing.map(({ name, use }) => (
            <div class="billing-card">
              <span class="billing-name">{name}</span>
              <span class="billing-use">{use}</span>
            </div>
          ))}
        </div>
        <p class="note">
          Always lowercase <code>voidstar</code> — including in “Randy Brown's voidstar”. Never “VoidStar” or “Void Star”.
        </p>
      </section>

      <!-- Watch -->
      <section class="press-section" id="watch">
        <h2 class="section-heading"><span class="heading-accent">▶</span> watch</h2>
        <div class="watch-grid">
          <div class="watch-main">
            {featured && (
              <VideoCard
                id={featured.id}
                title={featured.title ?? ''}
                description={featured.description}
                date={featured.date}
                tags={featured.tags}
                start={featured.start}
              />
            )}
          </div>
          <div class="watch-side">
            {moreVideos.map(v => (
              <VideoCard id={v.id} title={v.title ?? ''} description={v.description} date={v.date} tags={v.tags} start={v.start} />
            ))}
          </div>
        </div>
        <a href="/videos" class="section-link">all videos →</a>
      </section>

      <!-- The show -->
      <section class="press-section" id="show">
        <h2 class="section-heading"><span class="heading-accent">◈</span> the show</h2>
        <div class="show-grid">
          {press.show.map(({ mark, title, body }) => (
            <div class="show-card">
              <span class="show-mark" aria-hidden="true">{mark}</span>
              <h3 class="show-title">{title}</h3>
              <p class="show-body">{body}</p>
            </div>
          ))}
        </div>
        <p class="note">
          The whole instrument is open source and runs in a browser —
          <a href="/qualia">open qualia</a> to see it, or read
          <a href="/posts/qualia-overview">how it works</a>.
        </p>
      </section>

      {press.quotes.length > 0 && (
        <section class="press-section" id="press-quotes">
          <h2 class="section-heading"><span class="heading-accent">“</span> press</h2>
          <div class="quote-grid">
            {press.quotes.map(({ text, source, href }) => (
              <blockquote class="quote">
                <p>“{text}”</p>
                <cite>{href ? <a href={href} target="_blank" rel="noopener">{source}</a> : source}</cite>
              </blockquote>
            ))}
          </div>
        </section>
      )}

      {press.shows.length > 0 && (
        <section class="press-section" id="shows">
          <h2 class="section-heading"><span class="heading-accent">⌁</span> selected shows</h2>
          <ul class="show-list">
            {press.shows.map(({ date, venue, city, note }) => (
              <li>
                <span class="show-date">{date}</span>
                <span class="show-venue">{venue}{city && <span class="show-city"> · {city}</span>}</span>
                {note && <span class="show-note">{note}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Tech rider -->
      <section class="press-section" id="rider">
        <h2 class="section-heading"><span class="heading-accent">⚙</span> tech rider</h2>
        <div class="rider-grid">
          <div class="rider-col">
            <h3 class="rider-label">brings</h3>
            <ul class="rider-list">{press.rider.brings.map(i => <li>{i}</li>)}</ul>
          </div>
          <div class="rider-col">
            <h3 class="rider-label">needs</h3>
            <ul class="rider-list">{press.rider.needs.map(i => <li>{i}</li>)}</ul>
          </div>
        </div>
        <p class="note">Typical setup — small rooms and odd spaces are welcome; confirm the details per show.</p>
      </section>

      <!-- Logos & art -->
      <section class="press-section" id="assets">
        <h2 class="section-heading"><span class="heading-accent">⬡</span> photos, logos &amp; art</h2>
        <div class="photo-grid">
          {photos.map(({ img, file, label, credit, alt }) => (
            <div class="asset-card">
              <a href={img.src} class="photo-thumb asset-view" data-lightbox
                 data-caption={credit ? `${label} · photo: ${credit}` : label} data-file={file}>
                <Image src={img} alt={alt} widths={[320, 480]} sizes="(max-width: 560px) 100vw, 260px" class="asset-img asset-img-cover" />
              </a>
              <span class="asset-label">{label}</span>
              <span class="asset-note">
                {img.width}×{img.height}{credit && <> · photo: {credit}</>}
              </span>
              <a href={img.src} download={file} class="asset-dl">download ↓</a>
            </div>
          ))}
        </div>
        <div class="asset-grid">
          {logos.map(({ img, file, label, note }) => (
            <div class="asset-card">
              <a href={img.src} class="asset-thumb asset-thumb-logo asset-view" data-lightbox
                 data-caption={`voidstar ${label}`} data-file={file}>
                <Image src={img} alt={`voidstar ${label}`} width={240} class="asset-img" />
              </a>
              <span class="asset-label">{label}</span>
              <span class="asset-note">{note}</span>
              <a href={img.src} download={file} class="asset-dl">download ↓</a>
            </div>
          ))}
          {art.map(({ src, file, label, note }) => (
            <div class="asset-card">
              <a href={src} class="asset-thumb asset-view" data-lightbox data-caption={label} data-file={file}>
                <img src={src} alt={label} loading="lazy" class="asset-img asset-img-cover" />
              </a>
              <span class="asset-label">{label}</span>
              <span class="asset-note">{note}</span>
              <a href={src} download={file} class="asset-dl">download ↓</a>
            </div>
          ))}
        </div>
        <a href={PRESS_ZIP} download class="btn btn-outline zip-btn">download everything (.zip) ↓</a>
        <p class="note">
          Click any image to view it full size. The zip has every photo, logo, and art file
          plus a README with the bios and photo credits. Please credit photographers where
          listed. Logos are white-on-transparent — use them on dark backgrounds.
        </p>
      </section>

      <!-- About Randy -->
      <section class="press-section" id="randy">
        <div class="randy">
          <div class="randy-copy">
            <h2 class="section-heading"><span class="heading-accent">$</span> whoami — randy brown</h2>
            <p>
              Randy Brown is a Knoxville, Tennessee musician and software engineer. Pedal steel,
              Weissenborn, and guitar on one side; live coding, Web Audio, and realtime graphics on
              the other — voidstar is where the two meet.
            </p>
            <p>
              Outside voidstar, Randy plays pedal steel in
              <a href="https://nightjar2.bandcamp.com/" target="_blank" rel="noopener">nightjar</a>,
              is in the metal band
              <a href="https://dysmorphicdemiurge.bandcamp.com/" target="_blank" rel="noopener">Dysmorphic Demiurge</a>,
              releases solo music as <a href="https://soundcloud.com/randbrown" target="_blank" rel="noopener">randbrown</a>,
              and builds open-source music tools. The bands, the solo records, and the rest live at
              <a href="https://randbrown.com/press/" target="_blank" rel="noopener">randbrown.com</a>.
            </p>
          </div>
          <a href="https://randbrown.com/press/" target="_blank" rel="noopener" class="person-link">randy brown press kit ↗</a>
        </div>
      </section>

      <!-- Links + contact -->
      <section class="press-section" id="contact">
        <h2 class="section-heading"><span class="heading-accent">@</span> booking &amp; links</h2>
        <div class="contact-box">
          <div class="contact-copy">
            <p class="contact-lead">Booking, press, or collaboration:</p>
            {contact.email ? (
              <a href={`mailto:${contact.email}`} class="contact-main">{contact.email}</a>
            ) : (
              <a href={contact.instagram} target="_blank" rel="noopener" class="contact-main">DM @voidstar0 on Instagram</a>
            )}
            <p class="contact-alt">
              {contact.email && <>or DM <a href={contact.instagram} target="_blank" rel="noopener">@voidstar0</a> · </>}
              or reach Randy through <a href={contact.site} target="_blank" rel="noopener">randbrown.com</a>
            </p>
          </div>
        </div>

        <div class="links-grid">
          {press.links.map(({ label, handle, href, desc }) => (
            <a href={href} target="_blank" rel="noopener noreferrer" class="link-card">
              <span class="link-label">{label}</span>
              <span class="link-handle">{handle}</span>
              <span class="link-desc">{desc}</span>
            </a>
          ))}
        </div>
      </section>

    </div>
  </div>
  <!-- Full-size viewer for the photo/logo/art grid. Without JS the thumbnails
       are plain links to the full file, so it still opens in a tab. -->
  <dialog class="lightbox" id="lightbox" aria-label="Image viewer">
    <figure class="lb-figure">
      <img class="lb-img" alt="" />
      <figcaption class="lb-bar">
        <span class="lb-caption"></span>
        <span class="lb-actions">
          <a class="lb-dl" download>download ↓</a>
          <button type="button" class="lb-btn" data-lb="prev" aria-label="Previous image">←</button>
          <button type="button" class="lb-btn" data-lb="next" aria-label="Next image">→</button>
          <button type="button" class="lb-btn" data-lb="close" aria-label="Close">✕</button>
        </span>
      </figcaption>
    </figure>
  </dialog>
</BaseLayout>

<script>
  // Lightbox: click a thumbnail to view full size; ←/→ step, Esc closes
  // (native <dialog>), clicking the backdrop closes.
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')];
  const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
  const caption = dialog.querySelector<HTMLElement>('.lb-caption')!;
  const dl = dialog.querySelector<HTMLAnchorElement>('.lb-dl')!;
  let index = 0;

  const show = (i: number) => {
    index = (i + items.length) % items.length;
    const a = items[index];
    img.src = a.href;
    img.alt = a.querySelector('img')?.alt ?? '';
    caption.textContent = a.dataset.caption ?? '';
    dl.href = a.href;
    dl.download = a.dataset.file ?? '';
    // Logos are white-on-transparent; keep them on black.
    dialog.classList.toggle('lb-logo', a.classList.contains('asset-thumb-logo'));
  };

  items.forEach((a, i) => a.addEventListener('click', e => {
    e.preventDefault();
    show(i);
    dialog.showModal();
  }));
  dialog.addEventListener('click', e => {
    const action = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]')?.dataset.lb;
    if (action === 'prev') show(index - 1);
    else if (action === 'next') show(index + 1);
    else if (action === 'close' || e.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft') show(index - 1);
    else if (e.key === 'ArrowRight') show(index + 1);
  });
  dialog.addEventListener('close', () => img.removeAttribute('src'));
</script>

<script>
  // Copy-to-clipboard for the bios: promoters paste these straight into listings.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(btn => {
    btn.addEventListener('click', async e => {
      // Inside <summary>, a click would also toggle the <details>.
      e.preventDefault();
      e.stopPropagation();
      const src = btn.closest('[data-bio]')?.querySelector<HTMLElement>('[data-copy-src]');
      if (!src) return;
      const text = [...src.querySelectorAll('p')].map(p => p.textContent?.trim()).join('\n\n')
        || src.textContent?.trim() || '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'copied ✓';
      } catch {
        btn.textContent = 'copy failed';
      }
      setTimeout(() => { btn.textContent = 'copy'; }, 1600);
    });
  });
</script>

<style>
.press-wrap { padding: 4rem 0 6rem; }

/* Header */
.press-header {
  margin-bottom: 3rem;
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 2.5rem;
  align-items: center;
}
@media (max-width: 820px) {
  .press-header { grid-template-columns: 1fr; }
}
.press-header-copy { min-width: 0; }
.press-hero { margin: 0; }
.press-hero figcaption {
  margin-top: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-dim);
  text-align: right;
}
.press-hero-img {
  width: 100%;
  height: auto;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: 0 12px 44px rgba(0, 0, 0, 0.5), 0 0 0 1px var(--accent-glow);
}
@media (max-width: 820px) {
  .press-hero-img { aspect-ratio: 4 / 3; }
}
.press-label {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-dim);
  letter-spacing: 0.12em;
  margin-bottom: 0.75rem;
}
.press-title {
  font-family: var(--font-mono);
  font-size: clamp(2.5rem, 7vw, 4.5rem);
  letter-spacing: -0.02em;
  line-height: 1;
  background: linear-gradient(135deg, var(--text) 45%, var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.press-aka {
  margin-top: 0.75rem;
  font-family: var(--font-mono);
  font-size: 0.9rem;
  color: var(--text-dim);
}
.press-aka strong { color: var(--text-muted); font-weight: 500; }
.press-oneliner {
  margin-top: 1.25rem;
  font-size: clamp(1.05rem, 2vw, 1.25rem);
  color: var(--text-muted);
  line-height: 1.6;
  max-width: 52ch;
}
.press-toc {
  margin-top: 1.75rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}
.press-toc a {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--text-dim);
  border: 1px solid var(--border);
  padding: 0.25rem 0.7rem;
  border-radius: 999px;
  transition: all 0.2s;
}
.press-toc a:hover { color: var(--accent); border-color: var(--accent); }

/* Sections */
.press-section { padding: 2.5rem 0; border-top: 1px solid var(--border); scroll-margin-top: 4.5rem; }
.section-heading {
  font-size: 0.8rem;
  font-family: var(--font-mono);
  letter-spacing: 0.15em;
  color: var(--text-muted);
  text-transform: uppercase;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.heading-accent { color: var(--accent); }
.section-link {
  display: inline-block;
  margin-top: 1rem;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--text-muted);
}
.section-link:hover { color: var(--accent); }
.note {
  margin-top: 1.1rem;
  font-size: 0.88rem;
  color: var(--text-dim);
  line-height: 1.6;
  max-width: 70ch;
}
.note code {
  font-size: 0.9em;
  color: var(--cyan);
  background: var(--surface-2);
  border: 1px solid var(--border);
  padding: 0.05em 0.35em;
  border-radius: 4px;
}

/* Fact sheet + bios */
.fact-grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 2.5rem;
  align-items: start;
}
@media (max-width: 820px) {
  .fact-grid { grid-template-columns: 1fr; }
}
.facts {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
  overflow: hidden;
}
.fact { padding: 0.7rem 1rem; border-bottom: 1px solid var(--border); }
.fact:last-child { border-bottom: none; }
.fact dt {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
}
.fact dd { font-size: 0.92rem; color: var(--text); margin-top: 0.15rem; line-height: 1.45; }

.bios { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; }
.bio {
  padding: 1.25rem 1.4rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
}
.bio p {
  color: var(--text-muted);
  line-height: 1.75;
  font-size: 1rem;
  max-width: 68ch;
}
.bio p + p { margin-top: 0.9rem; }
.bio-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.75rem;
}
.bio-long .bio-head { margin-bottom: 0; cursor: pointer; list-style: none; }
.bio-long .bio-head::-webkit-details-marker { display: none; }
.bio-long .bio-label::before { content: '▸ '; color: var(--accent); }
.bio-long[open] .bio-label::before { content: '▾ '; }
.bio-long[open] .bio-head { margin-bottom: 0.75rem; }
.bio-label {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
}
.bio-count { color: var(--text-dim); text-transform: none; letter-spacing: 0.04em; }
.copy-btn {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-dim);
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 0.2rem 0.75rem;
  cursor: pointer;
  transition: all 0.2s;
  flex-shrink: 0;
}
.copy-btn:hover { color: var(--accent); border-color: var(--accent); }

/* Billing */
.billing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1rem;
}
.billing-card {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 1.25rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
}
.billing-name { font-family: var(--font-mono); font-size: 1.1rem; color: var(--text); }
.billing-use { font-size: 0.88rem; color: var(--text-muted); line-height: 1.55; }

/* Watch */
.watch-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 1.5rem;
  align-items: start;
}
.watch-side { display: flex; flex-direction: column; gap: 1.5rem; }
@media (max-width: 820px) {
  .watch-grid { grid-template-columns: 1fr; }
}

/* The show */
.show-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1rem;
}
.show-card {
  padding: 1.4rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
}
.show-mark { font-family: var(--font-mono); font-size: 1.4rem; color: var(--accent); }
